{
  "name": "vite-plugin-typed-graphql",
  "version": "4.0.0",
  "type": "module",
  "description": "Vite Plugin which enables the import of Typed-Document-Nodes directly from `.gql` / `.graphql` files, to allow for type-safe GraphQL implementations.",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "build-gql-declarations": "./dist/build-gql-declarations.mjs"
  },
  "homepage": "https://github.com/arma-events/vite-plugin-typed-graphql#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/arma-events/vite-plugin-typed-graphql.git"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "bugs": {
    "url": "https://github.com/arma-events/vite-plugin-typed-graphql/issues",
    "email": "derzade@gmail.com"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "build": "unbuild",
    "lint": "eslint ./src ./test",
    "pretest": "npm run build",
    "test": "vitest run",
    "fmt": "prettier --write .",
    "prepare": "npm run build"
  },
  "keywords": [
    "vite",
    "plugin",
    "graphql",
    "gql",
    "typed",
    "typescript"
  ],
  "author": "Jonas Schade <derzade@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@graphql-codegen/core": "^6.2.2",
    "@graphql-codegen/typed-document-node": "^7.1.1",
    "@graphql-codegen/typescript": "^6.1.1",
    "@graphql-codegen/typescript-operations": "^6.1.10",
    "@graphql-tools/graphql-file-loader": "^8.1.22",
    "@graphql-tools/import": "^7.2.2",
    "@graphql-tools/load": "^8.1.19",
    "commander": "^15.0.0",
    "esbuild": "^0.25.0 || ^0.27.0 || ^0.28.0",
    "graphql": "^16.8.1 || ^17.0.0",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "unbuild": "^3.6.1",
    "vite": "^8.3.4",
    "vite6": "npm:vite@^6.4.4",
    "vite7": "npm:vite@^7.3.7",
    "vite8": "npm:vite@^8.3.4",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "vite": "6 - 8"
  }
}
