{
  "name": "vite-plugin-typed-graphql",
  "version": "3.3.0",
  "description": "Vite Plugin which enables the import of Typed-Document-Nodes directly from `.gql` / `.graphql` files, to allow for type-safe GraphQL implementations.",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "build-gql-declarations": "./dist/build-gql-declarations.mjs"
  },
  "homepage": "https://github.com/arma-events/vite-plugin-typed-graphql#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/arma-events/vite-plugin-typed-graphql.git"
  },
  "files": [
    "dist"
  ],
  "bugs": {
    "url": "https://github.com/arma-events/vite-plugin-typed-graphql/issues",
    "email": "derzade@gmail.com"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "build": "unbuild",
    "lint": "eslint ./src ./test",
    "pretest": "npm run build",
    "test": "vitest run",
    "fmt": "prettier --write .",
    "prepare": "npm run build"
  },
  "keywords": [
    "vite",
    "plugin",
    "graphql",
    "gql",
    "typed",
    "typescript"
  ],
  "author": "Jonas Schade <derzade@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@graphql-codegen/core": "^4.0.2",
    "@graphql-codegen/typed-document-node": "^5.0.7",
    "@graphql-codegen/typescript": "^4.0.7",
    "@graphql-codegen/typescript-operations": "^4.2.1",
    "@graphql-tools/graphql-file-loader": "^8.1.19",
    "@graphql-tools/import": "^7.1.19",
    "@graphql-tools/load": "^8.1.16",
    "commander": "^15.0.0",
    "esbuild": "^0.25.0 || ^0.27.0 || ^0.28.0",
    "fast-glob": "^3.3.3",
    "graphql": "^16.8.1",
    "ts-morph": "^22.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "unbuild": "^3.6.1",
    "vite": "^8.2.2",
    "vite6": "npm:vite@^6.4.3",
    "vite7": "npm:vite@^7.3.6",
    "vite8": "npm:vite@^8.2.2",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "vite": "6 - 8"
  }
}
